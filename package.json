{
  "name": "omp-structured",
  "version": "1.0.0",
  "description": "Headless CLI: one omp-SDK completion constrained to a JSON Schema via real constrained decoding (vLLM response_format / Anthropic output_config.format), inheriting config/auth from ~/.omp.",
  "type": "module",
  "bin": {
    "omp-structured": "dist/cli.js"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "acceptance": "bash scripts/acceptance.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFDudley/omp-structured.git"
  },
  "bugs": {
    "url": "https://github.com/AFDudley/omp-structured/issues"
  },
  "homepage": "https://github.com/AFDudley/omp-structured#readme",
  "license": "MIT",
  "dependencies": {
    "@oh-my-pi/pi-ai": "18.2.8",
    "@oh-my-pi/pi-catalog": "18.2.8",
    "@oh-my-pi/pi-coding-agent": "18.2.8",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
